# Deployment target
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/cems-my
DEPLOY_APP_URL=https://staging.cems-my.example
DEPLOY_BRANCH=main

# SSH private key path (used only for remote deploys)
# DEPLOY_SSH_KEY=/home/user/.ssh/id_rsa_cems_staging

# Slack notification webhook (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Local mode (deploy to a directory on this machine, no SSH).
# Set DEPLOY_LOCAL=true, or simply use DEPLOY_HOST=127.0.0.1 / localhost.
DEPLOY_LOCAL=false
